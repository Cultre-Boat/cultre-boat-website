# Copy to .env.local for local development, and set the same keys in your hosting provider.

# Gmail account used to send contact-form emails.
EMAIL_USER=you@gmail.com
# A Gmail *App Password* (Google Account > Security > App passwords), not your normal password.
EMAIL_PASS=xxxxxxxxxxxxxxxx

# Optional: inbox that receives contact-form submissions (defaults to EMAIL_USER).
CONTACT_TO=

# Public site URL, used for canonical links, the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://cultreboat.com
